# AI SUMMARY CONFIG
MAX_EXTRACT_SIZE=5242880
EXTRACT_TIMEOUT_MS=15000
ALLOWED_ATTACHMENT_DOMAINS=res.cloudinary.com

# Chế độ AI: true = Mock, false = Provider thật
RUN_REAL_AI_SMOKE=false
AI_MOCK_MODE=true

# Provider AI
AI_PROVIDER=google-gemini

# Có thể dùng model Free Tier được cấp cho project
AI_MODEL=gemini-3.5-flash-lite

# Không ghi key thật vào file này
GEMINI_API_KEY=

# Model sinh câu trả lời
AI_CHAT_MODEL=gemini-3.5-flash-lite

# Model embedding Gemini
AI_EMBEDDING_MODEL=gemini-embedding-2

# Số chiều vector
AI_EMBEDDING_DIMENSIONS=768

# MongoDB Atlas Vector Search
AI_VECTOR_INDEX_NAME=ai_knowledge_vector_index

# RAG configuration
RAG_CHUNK_MAX_CHARS=2400
RAG_CHUNK_OVERLAP_CHARS=300
RAG_TOP_K=5
RAG_NUM_CANDIDATES=100
RAG_MIN_SCORE=0.65
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=2000
RAG_MAX_HISTORY_MESSAGES=10
