# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/ai-lms
# LƯU Ý: các script bảo trì trong src/scripts/ đọc MONGODB_URI (khác tên với app).
# Nếu chạy migrate/audit script, phải set thêm biến này, nếu không script sẽ tự
# fallback về localhost thay vì DB thật.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-lms
# Chỉ dùng cho integration test - tên database BẮT BUỘC có hậu tố _test
MONGO_TEST_URI=mongodb://127.0.0.1:27017/ai-lms_test

# Authentication JWT
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary - lưu trữ file upload (tài liệu bài giảng, bài nộp)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
# Bật mock để chạy dev/test mà không gọi API thật (không tốn quota)
AI_MOCK_MODE=false

# 8x8 JaaS Live Session Integration (Sprint J2 Security)
JAAS_APP_ID=your_jaas_app_id_here
JAAS_API_KEY_ID=your_jaas_app_id_here/your_key_id
JAAS_DOMAIN=8x8.vc
JAAS_PRIVATE_KEY=your_jaas_rsa_private_key_here

# RAG / AI Vector Search (yêu cầu Atlas Search Index — xem Backend/src/ai/RAG_SETUP.md)
AI_VECTOR_INDEX_NAME=ai_knowledge_vector_index
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_NUM_CANDIDATES=100
RAG_MIN_SCORE=0.65
RAG_CHUNK_MAX_CHARS=2400
RAG_CHUNK_OVERLAP_CHARS=300
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HISTORY_MESSAGES=10

