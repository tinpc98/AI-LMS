# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/ai-lms

# Authentication JWT
JWT_SECRET=your_jwt_secret_key_here

# 8x8 JaaS Live Session Integration (Sprint J2 Security)
JAAS_APP_ID=your_jaas_app_id_here
JAAS_API_KEY_ID=your_jaas_app_id_here/your_key_id
JAAS_DOMAIN=8x8.vc
JAAS_PRIVATE_KEY=your_jaas_rsa_private_key_here

# RAG / AI Vector Search (yêu cầu Atlas Search Index — xem Backend/src/ai/RAG_SETUP.md)
AI_VECTOR_INDEX_NAME=ai_knowledge_vector_index
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_NUM_CANDIDATES=100
RAG_MIN_SCORE=0.65
RAG_CHUNK_MAX_CHARS=2400
RAG_CHUNK_OVERLAP_CHARS=300
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HISTORY_MESSAGES=10

